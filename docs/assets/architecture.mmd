flowchart LR
  procfs["Linux procfs CPU and RAM counters"] --> system["Independent system worker"]
  mounts["Mountinfo, statfs, and diskstats"] --> system

  driver["NVIDIA driver and NVML"] --> gpu["Independent GPU worker"]
  hostengine["Local DCGM hostengine (optional)"] --> gpu
  processes["Current PID namespace (optional)"] --> gpu

  claims["DRA ResourceClaims (optional)"] --> bridge["Kubernetes attribution bridge"]
  slices["NVIDIA ResourceSlices (optional)"] --> bridge
  bridge --> socket["Root-only Unix socket"]
  socket --> gpu

  system --> coordinator["Snapshot coordinator"]
  gpu --> coordinator
  coordinator --> current["Immutable current snapshot"]
  coordinator --> history["Bounded in-memory history"]

  current --> tui["Bubble Tea TUI"]
  current --> cli["Table, JSON, and JSONL"]
  current --> api["Loopback HTTP and SSE API"]
  history --> tui
  history --> api
  api --> browser["Embedded React dashboard"]

  current --> projection["Sanitized latest-only uplink"]
  projection --> yggdrasil["Yggdrasil uplink-v1 ingress"]
