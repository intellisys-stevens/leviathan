[Unit]
Description=Recover an interrupted Leviathan update before monitoring starts
After=local-fs.target
Before=leviathan-updater.service

[Service]
Type=oneshot
RemainAfterExit=true
User=root
ExecStart=/usr/local/bin/leviathan-updater --config /etc/leviathan-updater/config.json recover
TimeoutStartSec=120s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/leviathan /var/lib/leviathan-updater
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
