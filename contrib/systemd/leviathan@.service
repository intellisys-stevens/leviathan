[Unit]
Description=Leviathan host and GPU monitoring dashboard for %i
Documentation=https://github.com/intellisys-stevens/leviathan
Wants=nvidia-persistenced.service
After=nvidia-persistenced.service

[Service]
Type=simple
User=%i
EnvironmentFile=-/etc/leviathan/leviathan.env
ExecStart=/usr/local/bin/leviathan --listen 127.0.0.1:1397 serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
