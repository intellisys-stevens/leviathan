[Unit]
Description=MIGLens GPU monitoring dashboard for %i
Documentation=https://github.com/intellisys-stevens/miglens
Wants=nvidia-persistenced.service
After=nvidia-persistenced.service

[Service]
Type=simple
User=%i
ExecStart=/usr/local/bin/miglens --listen 127.0.0.1:1397 serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
