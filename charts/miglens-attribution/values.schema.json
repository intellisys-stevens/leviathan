{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceNamespaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      }
    },
    "driver": { "type": "string", "minLength": 1 },
    "socketPath": {
      "type": "string",
      "pattern": "^/run/miglens/[A-Za-z0-9._-]+\\.sock$"
    }
  },
  "required": ["workspaceNamespaces", "driver", "socketPath"]
}
